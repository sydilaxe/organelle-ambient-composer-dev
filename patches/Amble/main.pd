#N canvas 50 50 1400 900 rng 0;
#X text 20 20 ac-rng: refresh acr1..acr4 (0..1). Seeded per piece \, so a seed replays its piece.;
#X obj 20 44 r ac-rng;
#X obj 20 68 t b b b b;
#X obj 20 92 r ac-seedrng;
#X obj 20 116 t f f f f;
#X obj 250 20 random 1000000;
#X obj 250 44 / 1e+06;
#X obj 250 68 v acr1;
